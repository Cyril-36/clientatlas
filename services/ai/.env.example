CLIENTATLAS_USER_DATABASE_URL=postgresql+asyncpg://clientatlas_runtime:change-me@localhost:5432/clientatlas
CLIENTATLAS_SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
CLIENTATLAS_SUPABASE_JWT_AUDIENCE=authenticated
CLIENTATLAS_SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json
CLIENTATLAS_ENVIRONMENT=development
CLIENTATLAS_OBJECT_STORAGE_ROOT=.clientatlas/storage
CLIENTATLAS_MAX_UPLOAD_BYTES=26214400
CLIENTATLAS_HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLIENTATLAS_HUGGINGFACE_GENERATION_MODEL=google/flan-t5-small
CLIENTATLAS_HUGGINGFACE_EMBEDDING_DEVICE=cpu
# Transformers uses -1 for CPU. Use 0 only with a supported GPU.
CLIENTATLAS_HUGGINGFACE_GENERATION_DEVICE=-1
CLIENTATLAS_EMBEDDING_DIMENSIONS=384
CLIENTATLAS_LOCAL_MODEL_MAX_INPUT_CHARACTERS=8000
CLIENTATLAS_LOCAL_MODEL_MAX_NEW_TOKENS=256
CLIENTATLAS_LLM_TIMEOUT_SECONDS=180
# Synthetic-demo workspaces only. Never use Gemini for confidential material.
CLIENTATLAS_GEMINI_API_KEY=
CLIENTATLAS_GEMINI_MODEL=gemini-2.5-flash-lite
CLIENTATLAS_GOOGLE_OAUTH_CLIENT_ID=
CLIENTATLAS_GOOGLE_OAUTH_CLIENT_SECRET=
CLIENTATLAS_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/oauth/google-drive
# URL-safe base64 encoding of exactly 32 random bytes.
CLIENTATLAS_TOKEN_ENCRYPTION_KEY=
CLIENTATLAS_TELEMETRY_ENABLED=true
CLIENTATLAS_OTLP_ENDPOINT=http://127.0.0.1:4318
