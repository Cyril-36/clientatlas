CLIENTATLAS_USER_DATABASE_URL=postgresql+asyncpg://clientatlas_runtime:change-me@localhost:5432/clientatlas
CLIENTATLAS_SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
CLIENTATLAS_SUPABASE_JWT_AUDIENCE=authenticated
CLIENTATLAS_SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json
CLIENTATLAS_ENVIRONMENT=development
CLIENTATLAS_OBJECT_STORAGE_ROOT=.clientatlas/storage
CLIENTATLAS_MAX_UPLOAD_BYTES=26214400
CLIENTATLAS_OLLAMA_BASE_URL=http://127.0.0.1:11434
CLIENTATLAS_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
CLIENTATLAS_OLLAMA_GENERATION_MODEL=qwen2.5:7b
CLIENTATLAS_EMBEDDING_DIMENSIONS=768
CLIENTATLAS_LLM_TIMEOUT_SECONDS=90
# Synthetic-demo workspaces only. Never use Gemini for confidential material.
CLIENTATLAS_GEMINI_API_KEY=
CLIENTATLAS_GEMINI_MODEL=gemini-2.5-flash-lite
