# User-scoped, non-owner, NOBYPASSRLS database login.
USER_DATABASE_URL=postgresql://clientatlas_runtime:change-me@localhost:5432/clientatlas

# Migration-only database login. Never import this from runtime modules.
MIGRATION_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/clientatlas

SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Local asymmetric JWKS endpoint. Hosted projects use:
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json

# Browser-safe values used by the frontend. The anon key is intentionally
# public; never substitute the service-role key.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_AI_API_URL=http://127.0.0.1:8000

# Defaults to true when omitted. Set false only for an authenticated local
# environment with the APIs above configured.
NEXT_PUBLIC_DEMO_MODE=true
